---
import type { Faq } from '../data/services';
interface Props { items: Faq[]; heading?: string }
const { items, heading = 'Najczęstsze pytania' } = Astro.props;
---
{items.length > 0 && (
  <section class="faq" aria-labelledby="faq-h">
    <h2 id="faq-h">{heading}</h2>
    {items.map((f) => (
      <details>
        <summary><h3>{f.q}</h3></summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>
)}

<style>
  .faq { max-width: var(--measure); }
  details { border-top: 1px solid var(--line); }
  details:last-of-type { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; list-style: none; padding: 16px 40px 16px 0; position: relative; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 6px; top: 50%; translate: 0 -50%; font-size: 1.6rem; font-weight: 400; color: var(--steel-2); transition: rotate 0.2s; }
  details[open] summary::after { rotate: 45deg; }
  summary h3 { font-size: var(--s1); font-variation-settings: 'wdth' 100; font-weight: 700; line-height: 1.3; margin: 0; }
  details p { padding-bottom: 12px; }
  @media (prefers-reduced-motion: reduce) { summary::after { transition: none; } }
</style>
