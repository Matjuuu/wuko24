---
import '../styles/global.css';
import { site } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CallBar from '../components/CallBar.astro';
import { graph, businessSchema, websiteSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  schema?: unknown[];
  ogType?: 'website' | 'article';
  noindex?: boolean;
}
const { title, description, schema = [], ogType = 'website', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const og = new URL('/og.png', site.url).toString();
const ld = graph(businessSchema(), websiteSchema(), ...schema);
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#16303f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="geo.region" content="PL-30" />
    <meta name="geo.placename" content={site.address.city} />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip sr-only" href="#tresc">Przejdź do treści</a>
    <Header />
    <main id="tresc">
      <slot />
    </main>
    <Footer />
    <CallBar />
  </body>
</html>

<style>
  .skip:focus { position: fixed; top: 8px; left: 8px; width: auto; height: auto; clip: auto; z-index: 100; padding: 10px 14px; background: var(--hivis); color: var(--ink); }
</style>
